# macOS local files
.DS_Store

# Local Codex instructions
AGENTS.md

# Xcode local user state
xcuserdata/
*.xcuserstate

# Xcode build outputs
build/
DerivedData/
.derivedData/
**/*.xcresult/
TestResults/*.md

# XcodeGen generated project
*.xcodeproj/

# CocoaPods installed dependencies (Podfile.lock is the lock file and is tracked)
Pods/

# CocoaPods generated workspace; only the SwiftPM lock file inside it is tracked
BrowseCraft.xcworkspace/*
!BrowseCraft.xcworkspace/xcshareddata/
BrowseCraft.xcworkspace/xcshareddata/*
!BrowseCraft.xcworkspace/xcshareddata/swiftpm/
BrowseCraft.xcworkspace/xcshareddata/swiftpm/*
!BrowseCraft.xcworkspace/xcshareddata/swiftpm/Package.resolved
web-analysis/

# Local production build settings
*.local.xcconfig

# Local sibling private rules repo
BrowseCraftRulesKit/
PrivatePackages/BrowseCraftCore
